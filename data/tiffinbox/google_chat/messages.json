  {
    "name": "spaces/payments/messages/d0c2be525a4.ca251fd74b3",
    "sender": {
      "name": "users/10002",
      "displayName": "Arjun Mehta",
      "type": "HUMAN"
    },
    "createTime": "2026-08-04T08:52:00Z",
    "text": "12 orders flipped to payment_failed between 14:02 and 14:06 even though the customers were charged.",
    "thread": {
      "name": "spaces/payments/threads/d0c2be525a4"
    },
    "space": {
      "name": "spaces/payments"
    }
  },
  {
    "name": "spaces/payments/messages/d0c2be525a4.da1a4e53083",
    "sender": {
      "name": "users/10002",
      "displayName": "Arjun Mehta",
      "type": "HUMAN"
    },
    "createTime": "2026-08-04T09:10:00Z",
    "text": "Found it. Our retry policy is 3 attempts at 30s, 60s and 120s, so we give up after 3.5 minutes. RupeeRail confirmed their webhooks pause ~5 min during deploys. Moving to 7 retries with exponential backoff, which covers about 13 minutes. Tracking in PAY-88.",
    "thread": {
      "name": "spaces/payments/threads/d0c2be525a4"
    },
    "space": {
      "name": "spaces/payments"
    }
  },
  {
    "name": "spaces/payments/messages/d0c2be525a4.37703382259",
    "sender": {
      "name": "users/10002",
      "displayName": "Arjun Mehta",
      "type": "HUMAN"
    },
    "createTime": "2026-08-04T09:11:00Z",
    "text": "Re-synced the 12 orders by hand from the RupeeRail dashboard.",
    "thread": {
      "name": "spaces/payments/threads/d0c2be525a4"
    },
    "space": {
      "name": "spaces/payments"
    }
  },
